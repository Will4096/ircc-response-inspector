{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "3.8.3",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "debugger",
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "options_page": "workspace.html?view=settings",
  "content_scripts": [
    {
      "matches": [
        "https://ircc-services.canada.ca/*"
      ],
      "js": [
        "i18n.js",
        "form.js",
        "scanner.js",
        "autofill.js",
        "mail-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://ircc-services.canada.ca/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "__MSG_extensionAction__"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "default_locale": "zh_CN",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://gmail.googleapis.com; base-uri 'none';"
  },
  "version_name": "3.8.3-mail-preview",
  "optional_permissions": [
    "identity",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://gc.auth.canada.ca/*",
    "https://clegc-gckey.gc.ca/*"
  ],
  "side_panel": {
    "default_path": "workspace.html?surface=panel"
  },
  "minimum_chrome_version": "116"
}
